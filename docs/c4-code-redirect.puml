@startuml c4-code-redirect

skin rose
hide empty members
hide empty method
left to right direction

skinparam  {
    defaultFontName             "Ubuntu"
    defaultFontSize             16
    shadowing                   true
    RoundCorner                 10
    packageBackgroundColor      LightGoldenRodYellow
    classBackgroundColor        AntiqueWhite
    backgroundColor             transparent
    dpi                         120
}

title Code diagram (Level 4) — Redirect flow in the current Shortly monolith

package "Endpoints" #palegreen {
    class UrlRedirectEndpoint <<static>> {
        + MapUrlRedirect(app: WebApplication): void
    }
}

package "Application" #lavender {
    interface ILinkService {
        + CreateLink(url: string, userId: long): Task<LinkResponse>
        + IncrementClicks(linkId: long): Task<LinkResponse>
        + GetLink(shortUrl: string): Task<LinkResponse>
        + GetAllLinks(): Task<List<LinkResponse>>
        + GetLinksByUserId(userId: long): Task<List<LinkResponse>>
    }

    class LinkService {
        - _linkRepository: ILinkRepository
        - _logger: ILogger<LinkService>
        + GetLink(shortUrl: string): Task<LinkResponse>
        + IncrementClicks(linkId: long): Task<LinkResponse>
    }

    class LinkResponse {
        + Id: long
        + Url: string
        + ShortUrl: string
        + Clicks: int
        + {static} From(link: Link): LinkResponse
    }

    interface ILinkRepository {
        + GetByIdAsync(id: long): Task<Link?>
        + GetByShortUrlAsync(shortUrl: string): Task<Link?>
        + SaveChangesAsync(): Task
    }
}

package "Infrastructure" #wheat {
    class LinkRepository {
        - _context: AppDbContext
        + GetByIdAsync(id: long): Task<Link?>
        + GetByShortUrlAsync(shortUrl: string): Task<Link?>
    }
}

package "Domain" #palegreen {
    class Link {
        + Id: long
        + Url: string
        + ShortUrl: string
        + Clicks: int
        + UserId: long
        + IncrementClicks(): void
    }
}

UrlRedirectEndpoint ..> ILinkService : "1: GetLink(shortUrl)"
UrlRedirectEndpoint ..> ILinkService : "2: IncrementClicks(link.Id)"
ILinkService <|.. LinkService : implements
LinkService ..> ILinkRepository : depends on
LinkService ..> LinkResponse : returns
LinkResponse ..> Link : maps from
ILinkRepository <|.. LinkRepository : implements
LinkRepository ..> Link : persists
LinkService ..> Link : "calls link.IncrementClicks()"

@enduml
