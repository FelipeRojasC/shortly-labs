@startuml c4-component-url-service

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Component diagram for URL Service

Container(apiGateway, "API Gateway", "ASP.NET Core / YARP", "Routes external requests.")
ContainerDb(urlDb, "URL Database", "PostgreSQL", "Stores link records.")
ContainerDb(redirectCache, "Redirect Cache", "Redis", "shortUrl -> originalUrl mapping.")

Container_Boundary(urlService, "URL Service") {
    Component(linksEndpoint, "Links API Endpoint", "Minimal API (proposed)", "Exposes POST/GET/DELETE /api/urls. Reads Content-Type, writes negotiated response.")
    Component(contentNegotiator, "Content Negotiation", "Custom IResult (proposed)", "Serializes/deserializes JSON or XML based on Accept/Content-Type headers.")
    Component(linkService, "Link Service", "ILinkService / LinkService", "Business logic: create, retrieve, delete links; validates input.")
    Component(linkRepository, "Link Repository", "ILinkRepository / LinkRepository (EF Core)", "Data access for the Link entity.")
    Component(cacheInvalidator, "Cache Invalidator", "IDistributedCache client", "Populates/invalidates the Redirect Cache on create or delete.")
}

Rel(apiGateway, linksEndpoint, "Forwards /api/urls/*", "HTTP/REST")
Rel(linksEndpoint, contentNegotiator, "Delegates (de)serialization to")
Rel(linksEndpoint, linkService, "Calls")
Rel(linkService, linkRepository, "Uses")
Rel(linkService, cacheInvalidator, "Notifies on create/delete")
Rel(linkRepository, urlDb, "Reads from and writes to", "SQL (EF Core)")
Rel(cacheInvalidator, redirectCache, "Writes/deletes cache entries", "Redis protocol")

SHOW_LEGEND()

@enduml
